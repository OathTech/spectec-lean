#!/usr/bin/env bash
# Corpus-wide wast classification sweep (arc-2 DONE item "harness
# classifies N/N assertions across 97/97 files — zero unclassified, zero
# false passes"). Honest-classes design: assertions the engine cannot
# decide within the per-file wall budget land in EXPLICIT classes —
# `timeout` (wall budget), `resource` (memory-cap kill), `fuel` (engine
# fuel), `unsupported:<class>` (driver boundary) — never silent, never a
# false pass. Passing is NOT claimed by this sweep; the pass floor is a
# separate (unmet, arc-2 Results) DONE item.
#
# usage: scripts/wast-classify [timeout-s] [fuel] [steps]
# outputs: artifacts/wast/<name>.{cmds,rows}; rollup on stdout.
set -uo pipefail
T=${1:-120}; FUEL=${2:-100000}; STEPS=${3:-5000}
cd "$(dirname "$0")/.."
source scripts/env.sh
SPECTEC=deps/spectec/spectec/spectec
BIN=./.lake/build/bin/spectecil
DUMP=artifacts/wast/w3.sexpr
mkdir -p artifacts/wast
[ -s "$DUMP" ] || "$SPECTEC" deps/spectec/specification/wasm-3.0/*.spectec \
  --ast-structured -o "$DUMP" || { echo "dump failed" >&2; exit 1; }

for f in deps/wasm-spec/test/core/*.wast; do
  name=$(basename "$f" .wast)
  cmds=artifacts/wast/$name.cmds
  if [ ! -s "$cmds" ]; then
    if ! "$SPECTEC" deps/spectec/specification/wasm-3.0/*.spectec \
         --wast-sexpr "$f" -o "$cmds" 2>"artifacts/wast/$name.driver-err"; then
      # fail LOUDLY: a driver crash must be visible, not synthesized around
      echo "DRIVER-FAIL $name (see artifacts/wast/$name.driver-err)" >&2
      rm -f "$cmds"
    fi
  fi
done

for f in deps/wasm-spec/test/core/*.wast; do
  name=$(basename "$f" .wast)
  cmds=artifacts/wast/$name.cmds
  rows=artifacts/wast/$name.rows
  [ -s "$cmds" ] || continue
  [ -s "$rows" ] && continue   # resumable
  total=$(wc -l < "$cmds")
  SPECTEC_MEM_MAX=${WAST_MEM:-16G} timeout "$T" scripts/capped \
    "$BIN" run-wast "$DUMP" "$cmds" "$FUEL" "$STEPS" \
    > "$rows.tmp" 2>/dev/null
  rc=$?
  grep -v '^SUMMARY' "$rows.tmp" | sed 's/\t\[[0-9]*ms\]$//' > "$rows.partial"
  rm -f "$rows.tmp"
  done_rows=$(wc -l < "$rows.partial")
  cls=""
  if [ "$rc" -eq 124 ] || [ "$rc" -eq 143 ]; then cls=timeout
  elif [ "$rc" -eq 137 ]; then cls=resource
  elif [ "$rc" -ne 0 ]; then cls="abort-$rc"
  fi
  if [ "$done_rows" -lt "$total" ]; then
    [ -n "$cls" ] || cls=abort-early
    i=$done_rows
    while [ "$i" -lt "$total" ]; do
      printf '%d\t%s\t\n' "$i" "$cls" >> "$rows.partial"
      i=$((i+1))
    done
  fi
  mv "$rows.partial" "$rows"
  echo "done $name: $done_rows/$total rows native, kill-class=${cls:-none}" >&2
done
