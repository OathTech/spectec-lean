#!/usr/bin/env bash
# One-command gate (CLAUDE.md "The oracle and the gate"; arc-1 charter
# DONE list). Green before any checkpoint claim, audit, or merge.
#
# Checks, in order (all mandatory, fail-fast):
#   1. upstream pin: deps/spectec HEAD == baselines/upstream-pins.txt
#   2. regenerate the wasm-3.0 IL dump (--ast-structured, D3 patch) with
#      the pinned+patched OCaml spectec;
#      sha256 must equal the pinned value (drift in either direction fails)
#   3. capped `lake build` (zero errors; warnings reported)
#   4. hygiene scan: no `partial def`, `sorry`, `native_decide` in
#      SpecTecLean/ or Main.lean (deterrent standard: catches the honest
#      mistake, not a motivated adversary — do not harden)
#   5. full round-trip: text -> Sexpr -> IL -> Sexpr -> text byte-identical
#      (plus the Sexpr-layer-only round-trip); 5b: wasm-1.0/2.0 likewise,
#      sha-pinned; 5c: tracked synthetic corpus for wasm-absent branches
#   6. fail-closed probes: three corrupted dumps must FAIL with exit 1
#
# The OCaml toolchain must be built (deps/spectec/spectec/spectec); this
# script does not build it (see docs/2026-08-20_ocaml-env-setup.md).
set -euo pipefail
cd "$(dirname "$0")/.."

fail() { echo "ci: FAIL — $*" >&2; exit 1; }
note() { echo "ci: $*"; }

# --- env ---------------------------------------------------------------
source scripts/env.sh

# --- 1. upstream pin ---------------------------------------------------
pin_commit=$(awk '$1=="spectec-commit"{print $2}' baselines/upstream-pins.txt)
pin_sha=$(awk '$1=="wasm3-il-sexpr-sha256"{print $2}' baselines/upstream-pins.txt)
[ -n "$pin_commit" ] && [ -n "$pin_sha" ] || fail "baselines/upstream-pins.txt unreadable"
actual_commit=$(git -C deps/spectec rev-parse HEAD)
[ "$actual_commit" = "$pin_commit" ] \
  || fail "deps/spectec at $actual_commit, pinned $pin_commit (bump is an arc-level decision)"
diff <(git -C deps/spectec diff) <(cat patches/*.patch) >/dev/null \
  || fail "deps/spectec worktree diff != vendored patches/ (run scripts/apply-patches on a clean pin; untracked files are not checked)"
note "pin OK: spectec @ ${pin_commit:0:12} + vendored patches"

# --- 2. regenerate + hash the oracle dump ------------------------------
SPECTEC=deps/spectec/spectec/spectec
[ -x "$SPECTEC" ] || fail "$SPECTEC not built (cd deps/spectec/spectec && make exe)"
mkdir -p artifacts
"$SPECTEC" deps/spectec/specification/wasm-3.0/*.spectec --ast-structured -o artifacts/ci-dump.sexpr \
  || fail "OCaml spectec --ast-structured failed"
actual_sha=$(sha256sum artifacts/ci-dump.sexpr | awk '{print $1}')
[ "$actual_sha" = "$pin_sha" ] \
  || fail "IL dump sha256 drifted: $actual_sha != pinned $pin_sha (re-pin only deliberately, with the reason committed)"
note "oracle dump OK: sha256 ${actual_sha:0:12}… ($(wc -c < artifacts/ci-dump.sexpr) bytes)"

# --- 3. capped build ---------------------------------------------------
build_log=$(mktemp artifacts/ci-build-XXXX.log)
scripts/capped lake build >"$build_log" 2>&1 || { cat "$build_log"; fail "lake build failed"; }
if grep -q "warning" "$build_log"; then
  note "build OK with warnings:"; { grep "warning" "$build_log" | head -5; } || true
else
  note "build OK (warning-free)"
fi
rm -f "$build_log"

# --- 4. hygiene scan ---------------------------------------------------
# Word-boundary grep over tracked Lean sources; `partial def`, `sorry`,
# `native_decide` are all forbidden in anything claimed done (CLAUDE.md).
if grep -rnE '(^|[^[:alnum:]_])(partial[[:space:]]+def|sorry|native_decide|unsafe|implemented_by)([^[:alnum:]_]|$)|set_option[[:space:]]+(maxHeartbeats|maxRecDepth)' \
     --include='*.lean' SpecTecLean/ SpecTecLean.lean Main.lean; then
  fail "forbidden construct (partial def / sorry / native_decide / unsafe / implemented_by) in sources"
fi
note "hygiene OK: no partial def / sorry / native_decide / unsafe / implemented_by"

# --- 5. round-trips ----------------------------------------------------
BIN=./.lake/build/bin/spectecil
"$BIN" roundtrip-sexpr artifacts/ci-dump.sexpr || fail "Sexpr-layer roundtrip failed"
"$BIN" roundtrip artifacts/ci-dump.sexpr || fail "full IL roundtrip failed"

# --- 5b. extra corpora (sha-pinned like wasm-3.0; audit finding B8) ----
for v in 1.0 2.0; do
  "$SPECTEC" deps/spectec/specification/wasm-$v/*.spectec --ast-structured \
    -o "artifacts/ci-dump-w$v.sexpr" || fail "OCaml spectec --ast-structured failed (wasm-$v)"
  pin_v=$(awk -v k="wasm${v%%.*}-il-sexpr-sha256" '$1==k{print $2}' baselines/upstream-pins.txt)
  sha_v=$(sha256sum "artifacts/ci-dump-w$v.sexpr" | awk '{print $1}')
  [ "$sha_v" = "$pin_v" ] || fail "wasm-$v IL dump sha256 drifted: $sha_v != pinned $pin_v"
  "$BIN" roundtrip "artifacts/ci-dump-w$v.sexpr" || fail "roundtrip failed (wasm-$v)"
  rm -f "artifacts/ci-dump-w$v.sexpr"
done

# --- 5c. synthetic coverage corpus (tracked, hand-authored) -------------
# Exercises reader/printer branches ABSENT from all wasm corpora (audit
# 2026-08-20 finding B2: int, rat, unopt/TheE, let/LetPr, neg/NegPr,
# impl, un plus/minus, bool false, list1). This tests print∘parse = id
# and branch coverage only — there is no OCaml oracle for these inputs
# (the OCaml side cannot be made to emit them from a wasm spec).
"$BIN" roundtrip baselines/synthetic-coverage.sexpr \
  || fail "synthetic coverage corpus roundtrip failed"

# --- 5d. validator (arc-2 stages 3-4: eval.ml+valid.ml mirrors) --------
# The OCaml elaborator only emits well-formed IL, so all-green IS the
# oracle signal (charter stage 3). Synthetic corpus is round-trip-only
# (hand-authored, not valid IL — no binders).
"$BIN" validate artifacts/ci-dump.sexpr || fail "wasm-3.0 validation failed"
for v in 1.0 2.0; do
  "$SPECTEC" deps/spectec/specification/wasm-$v/*.spectec --ast-structured     -o "artifacts/ci-val-w$v.sexpr" || fail "dump failed (wasm-$v)"
  "$BIN" validate "artifacts/ci-val-w$v.sexpr"     || fail "wasm-$v validation failed"
  rm -f "artifacts/ci-val-w$v.sexpr"
done

# validator mutation probes: type-broken dumps must be REJECTED
vprobe() { # name, transform
  local name=$1; shift
  "$@" < artifacts/ci-dump.sexpr > "artifacts/ci-vprobe-$name.sexpr"
  if "$BIN" validate "artifacts/ci-vprobe-$name.sexpr" >/dev/null 2>&1; then
    fail "validator probe '$name' PASSED (must fail)"
  fi
  rm -f "artifacts/ci-vprobe-$name.sexpr"
}
vprobe undeclared-type 'sed' 's/(var "instr")/(var "instrr")/'
vprobe undeclared-var  'sed' 's/(var "numtype")/(var "numtypee")/'
vprobe bad-cmp-annot   'sed' '0,/(cmp eq bool/s//(cmp lt bool/'
vprobe iter-kind-flip  'sed' 's/(iter (var "val") list)/(iter (var "val") opt)/'
vprobe num-typ-flip    'sed' '0,/(num (nat 0))/s//(num (int 0))/'
note "validator OK: 3 corpora green, 5/5 mutation probes rejected"

# --- 6. fail-closed probes ---------------------------------------------
probe() { # name, transform (stdin->stdout)
  local name=$1; shift
  "$@" < artifacts/ci-dump.sexpr > "artifacts/ci-probe-$name.sexpr"
  if "$BIN" roundtrip "artifacts/ci-probe-$name.sexpr" >/dev/null 2>&1; then
    fail "fail-closed probe '$name' PASSED (must fail)"
  fi
  rm -f "artifacts/ci-probe-$name.sexpr"
}
probe unknown-head   sed 's/(case/(kase/'
probe truncated      head -c 100000
probe non-canonical  sed 's/(nat 1)/(nat 01)/'
note "fail-closed probes OK (3/3 rejected)"

# --- 7. wast pilot differential (arc-2 stage 7, EARLY-EXIT scope) ------
# The spec-rule runner executes a tracked pilot script end-to-end
# (define → instantiate → invoke → assert_return) against the OCaml
# reference-interpreter-parsed command stream; classifications must
# match the tracked baseline exactly. Full-suite scaling was declared an
# arc-2 early exit (see the charter Results); this pins what EXISTS.
"$SPECTEC" deps/spectec/specification/wasm-3.0/*.spectec   --wast-sexpr baselines/wast/mini.wast -o artifacts/ci-mini.cmds   || fail "OCaml --wast-sexpr driver failed on mini.wast"
"$BIN" run-wast artifacts/ci-dump.sexpr artifacts/ci-mini.cmds 2>/dev/null   | sed 's/\t\[[0-9]*ms\]$//' > artifacts/ci-mini.rows   || fail "run-wast failed on mini"
diff artifacts/ci-mini.rows baselines/wast/mini.expected.tsv   || fail "wast pilot classifications drifted from baselines/wast/mini.expected.tsv"
rm -f artifacts/ci-mini.cmds artifacts/ci-mini.rows
note "wast pilot OK: mini.wast classifications match baseline"

rm -f artifacts/ci-dump.sexpr
echo "ci: GREEN"
