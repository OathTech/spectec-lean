diff --git a/spectec/src/backend-ast/print.ml b/spectec/src/backend-ast/print.ml
index eaa4391..3cbe35d 100644
--- a/spectec/src/backend-ast/print.ml
+++ b/spectec/src/backend-ast/print.ml
@@ -8,10 +8,40 @@ open Ast
 
 (* Literal *)
 
+(* SPECTEC-LEAN PATCH D3 (2026-08-20): structured dump mode.
+ * Default output is UNCHANGED; `--ast-structured` (exe flag) sets
+ * `structured` and switches atoms/mixops to lossless structural encoding,
+ * adds LetPr binders, and def-level source regions. *)
+let structured = ref false
+
 let bool b = Atom (Bool.to_string b)
 let text t = Atom ("\"" ^ String.escaped t ^ "\"")
 let id x = text x.it
-let mixop op = text (Mixop.to_string op)
+
+let atom_sx at =
+  match at.it with
+  | Atom.Atom s -> Node ("a", [text s])
+  | _ -> Node ("s", [Atom (Atom.name at)])
+
+let rec mixop_sx op =
+  match op with
+  | Mixop.Arg _ -> Atom "%"
+  | Mixop.Atom at -> atom_sx at
+  | Mixop.Brack (l, m, r) -> Node ("brack", [atom_sx l; mixop_sx m; atom_sx r])
+  | Mixop.Infix (m1, at, m2) ->
+    Node ("infix", [mixop_sx m1; atom_sx at; mixop_sx m2])
+  | Mixop.Seq ms -> Node ("seq", List.map mixop_sx ms)
+
+let mixop op = if !structured then mixop_sx op else text (Mixop.to_string op)
+let atom at =
+  if !structured then atom_sx at else text (Atom.to_string at)
+
+let at_sx (r : Source.region) =
+  Node ("at", [text r.left.file;
+    Atom (string_of_int r.left.line); Atom (string_of_int r.left.column);
+    Atom (string_of_int r.right.line); Atom (string_of_int r.right.column)])
+
+let ats r = if !structured then [at_sx r] else []
 
 let num = function
   | `Nat n -> Node ("nat", [Atom (Z.to_string n)])
@@ -87,7 +117,7 @@ and typbind (x, t) =
   Node ("bind", [id x; typ t])
 
 and typfield (at, (t, qs, prs), _hints) =
-  Node ("field", mixop (Mixop.Atom at) :: typ t :: List.map param qs @ List.map prem prs)
+  Node ("field", atom at :: typ t :: List.map param qs @ List.map prem prs)
 
 and typcase (op, (t, qs, prs), _hints) =
   Node ("case", mixop op :: typ t :: List.map param qs @ List.map prem prs)
@@ -96,6 +126,9 @@ and typcase (op, (t, qs, prs), _hints) =
 (* Expressions *)
 
 and exp e =
+  if !structured then Node ("!", [exp' e; typ e.note]) else exp' e
+
+and exp' e =
   match e.it with
   | VarE x -> Node ("var", [id x])
   | BoolE b -> Node ("bool", [bool b])
@@ -109,7 +142,7 @@ and exp e =
   | UpdE (e1, p, e2) -> Node ("upd", [exp e1; path p; exp e2])
   | ExtE (e1, p, e2) -> Node ("ext", [exp e1; path p; exp e2])
   | StrE efs -> Node ("struct", List.map expfield efs)
-  | DotE (e1, at) -> Node ("dot", [exp e1; mixop (Mixop.Atom at)])
+  | DotE (e1, at) -> Node ("dot", [exp e1; atom at])
   | CompE (e1, e2) -> Node ("comp", [exp e1; exp e2])
   | MemE (e1, e2) -> Node ("mem", [exp e1; exp e2])
   | LenE e1 -> Node ("len", [exp e1])
@@ -129,14 +162,17 @@ and exp e =
   | IfE (e1, e2, e3) -> Node ("if", [exp e1; exp e2; exp e3])
 
 and expfield (at, e) =
-  Node ("field", [mixop (Mixop.Atom at); exp e])
+  Node ("field", [atom at; exp e])
 
 and path p =
+  if !structured then Node ("!", [path' p; typ p.note]) else path' p
+
+and path' p =
   match p.it with
   | RootP -> Atom "root"
   | IdxP (p1, e) -> Node ("idx", [path p1; exp e])
   | SliceP (p1, e1, e2) -> Node ("slice", [path p1; exp e1; exp e2])
-  | DotP (p1, at) -> Node ("dot", [path p1; mixop (Mixop.Atom at)])
+  | DotP (p1, at) -> Node ("dot", [path p1; atom at])
 
 and iterexp (it, xes) =
   iter it :: List.map (fun (x, e) -> Node ("dom", [id x; exp e])) xes
@@ -163,7 +199,8 @@ and prem pr =
   match pr.it with
   | RulePr (x, as1, op, e) -> Node ("rule", id x :: List.map arg as1 @ [mixop op; exp e])
   | IfPr e -> Node ("if", [exp e])
-  | LetPr (_qs, e1, e2) -> Node ("let", [exp e1; exp e2])
+  | LetPr (qs, e1, e2) ->
+    Node ("let", (if !structured then List.map param qs else []) @ [exp e1; exp e2])
   | ElsePr -> Atom "else"
   | IterPr (pr1, it) -> Node ("iter", [prem pr1] @ iterexp it)
   | NegPr pr1 -> Node ("neg", [prem pr1])
@@ -188,35 +225,35 @@ and param p =
 let inst inst =
   match inst.it with
   | InstD (ps, as_, dt) ->
-    Node ("inst", List.map param ps @ List.map arg as_ @ [deftyp dt])
+    Node ("inst", ats inst.at @ List.map param ps @ List.map arg as_ @ [deftyp dt])
 
 let rule rule =
   match rule.it with
   | RuleD (x, ps, op, e, prs) ->
-    Node ("rule", [id x] @ List.map param ps @ [mixop op; exp e] @ List.map prem prs)
+    Node ("rule", [id x] @ ats rule.at @ List.map param ps @ [mixop op; exp e] @ List.map prem prs)
 
 let clause clause =
   match clause.it with
   | DefD (ps, as_, e, prs) ->
-    Node ("clause", List.map param ps @ List.map arg as_ @ [exp e] @ List.map prem prs)
+    Node ("clause", ats clause.at @ List.map param ps @ List.map arg as_ @ [exp e] @ List.map prem prs)
 
 let prod prod =
   match prod.it with
   | ProdD (ps, g, e, prs) ->
-    Node ("prod", List.map param ps @ [sym g; exp e] @ List.map prem prs)
+    Node ("prod", ats prod.at @ List.map param ps @ [sym g; exp e] @ List.map prem prs)
 
 let rec def d =
   match d.it with
   | TypD (x, ps, insts) ->
-    Node ("typ", [id x] @ List.map param ps @ List.map inst insts)
+    Node ("typ", [id x] @ ats d.at @ List.map param ps @ List.map inst insts)
   | RelD (x, ps, op, t, rules) ->
-    Node ("rel", [id x] @ List.map param ps @ [mixop op; typ t] @ List.map rule rules)
+    Node ("rel", [id x] @ ats d.at @ List.map param ps @ [mixop op; typ t] @ List.map rule rules)
   | DecD (x, ps, t, clauses) ->
-    Node ("def", [id x] @ List.map param ps @ [typ t] @ List.map clause clauses)
+    Node ("def", [id x] @ ats d.at @ List.map param ps @ [typ t] @ List.map clause clauses)
   | GramD (x, ps, t, prods) ->
-    Node ("gram", [id x] @ List.map param ps @ [typ t] @ List.map prod prods)
+    Node ("gram", [id x] @ ats d.at @ List.map param ps @ [typ t] @ List.map prod prods)
   | RecD ds ->
-    Node ("rec", List.map def ds)
+    Node ("rec", ats d.at @ List.map def ds)
   | HintD _ ->
     Atom ""
 
